# =============================================================================
# DCEngineer — copy to .env and edit. Never commit a filled .env.
# =============================================================================

# Published image (GitHub Container Registry). Override to use a fork or a local tag.
DCE_IMAGE=ghcr.io/ari-dann/dcengineer:latest

# --- Application ---
DCE_APP_NAME=DCEngineer
DCE_HOSTNAME=dce.example.com
DCE_PUBLIC_URL=https://dce.example.com
DCE_CONTAINER_NAME=dcengineer
TZ=UTC
LOG_LEVEL=INFO

# JWTAuth — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=14

# First-boot admin (created only when the user table is empty)
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Vision sidecar (created on boot when username + password are set)
BOOTSTRAP_SIDECAR_USER=sidecar
BOOTSTRAP_SIDECAR_PASSWORD=
BOOTSTRAP_SIDECAR_EMAIL=sidecar@localhost
DCE_SIDECAR_USER=sidecar
DCE_SIDECAR_PASSWORD=
DCE_API_URL=http://dcengineer:8080
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-20250514
VISION_POLL_SECONDS=8
VISION_MAX_FRAMES=24

# --- Database ---
# sqlite (default) or postgresql+psycopg://user:pass@host:5432/dcengineer
DATABASE_URL=sqlite:////data/dcengineer.db

# --- HTTP ---
DCE_PORT=8080
CORS_ORIGINS=https://dce.example.com
MAX_UPLOAD_MB=32
NEAR_EOL_DAYS=365

# --- Bind mounts on the Docker host ---
DCE_DATA_PATH=./data
DCE_BACKUP_HOST_PATH=./backups
PUID=1000
PGID=1000

# --- Primary storage (local | nfs | sftp) ---
# local: files live in STORAGE_LOCAL_PATH (bind-mounted)
# nfs:   same as local, but STORAGE_LOCAL_PATH should be the host NFS mount
# sftp:  objects are written to an SFTP server (paramiko); sqlite still local
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/files

# NFS (used when STORAGE_BACKEND=nfs, and/or for backup volume driver)
# Use your NAS hostname or overlay-VPN address — not a public IP unless intended.
NFS_HOST=nas.example.net
NFS_EXPORT=/mnt/pool/dce-data
NFS_MOUNT_OPTIONS=rw,nfsvers=4,hard,timeo=600,retrans=2,_netdev
NFS_VERSION=4

# SFTP object storage
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_KEY_PATH=
SFTP_REMOTE_PATH=/dcengineer
SFTP_KNOWN_HOSTS=

# --- Backups ---
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=14
BACKUP_PATH=/backups

# Optional dedicated NFS volume for backups (see docker-compose.nfs.yml)
BACKUP_NFS_HOST=nas.example.net
BACKUP_NFS_EXPORT=/mnt/pool/dce-backups

# --- Reverse proxy (compose overlays) ---
# traefik | nginx | caddy | none
REVERSE_PROXY=caddy
TRAEFIK_NETWORK=traefik-net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_DYNAMIC_DIR=/opt/traefik/dynamic

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ACME email for Caddy / Let's Encrypt
ACME_EMAIL=admin@example.com
