# Dynamic Traefik file for DCEngineer (no container labels).
# Render with: bash scripts/render-traefik.sh [output-path]
# Values come from DCE_HOSTNAME, TRAEFIK_ENTRYPOINT, TRAEFIK_CERT_RESOLVER,
# and DCE_CONTAINER_NAME in the environment or .env.

http:
  routers:
    dcengineer:
      rule: "Host(`__DCE_HOSTNAME__`)"
      entryPoints:
        - __TRAEFIK_ENTRYPOINT__
      service: dcengineer
      tls:
        certResolver: __TRAEFIK_CERT_RESOLVER__
      middlewares:
        - dcengineer-headers
        - dcengineer-compress

  services:
    dcengineer:
      loadBalancer:
        servers:
          - url: "http://__DCE_CONTAINER_NAME__:8080"
        passHostHeader: true
        healthCheck:
          path: /api/health
          interval: 30s
          timeout: 5s

  middlewares:
    dcengineer-headers:
      headers:
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: true
        forceSTSHeader: true
        browserXssFilter: true
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: strict-origin-when-cross-origin
        customResponseHeaders:
          X-App: DCEngineer
    dcengineer-compress:
      compress: {}
