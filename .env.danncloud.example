# =============================================================================
# DCEngineer — Danncloud (dce.rootpcs.cloud) example
# Copy to /opt/docker/Files/dcengineer/.env and fill secrets.
# =============================================================================

DCE_APP_NAME=DCEngineer
DCE_HOSTNAME=dce.rootpcs.cloud
DCE_PUBLIC_URL=https://dce.rootpcs.cloud
TZ=America/Los_Angeles
LOG_LEVEL=INFO

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=720
JWT_REFRESH_DAYS=14

BOOTSTRAP_ADMIN_USER=ari
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_NOW
BOOTSTRAP_ADMIN_EMAIL=ari@rootpcs.com

DATABASE_URL=sqlite:////data/dcengineer.db

DCE_PORT=8080
CORS_ORIGINS=https://dce.rootpcs.cloud
MAX_UPLOAD_MB=32
NEAR_EOL_DAYS=365

PUID=1000
PGID=1000

# Danncloud SSD for sqlite + attachments; NFS (Tleilax) for backups
DCE_DATA_PATH=/opt/docker/Files/dcengineer/data
DCE_BACKUP_HOST_PATH=/mnt/dce-backups

# App data stays on Danncloud SSD; backups go to Tleilax over NFS.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/files

# TrueNAS Tleilax (Zerotier 10.20.30.3) — host-mount this on Danncloud
NFS_HOST=10.20.30.3
NFS_EXPORT=/mnt/VDEV1/dce-backups
NFS_MOUNT_OPTIONS=rw,nfsvers=4,hard,timeo=600,retrans=2,_netdev
NFS_VERSION=4

SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_KEY_PATH=
SFTP_REMOTE_PATH=/dcengineer
SFTP_KNOWN_HOSTS=

BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=14
BACKUP_PATH=/backups

BACKUP_NFS_HOST=10.20.30.3
BACKUP_NFS_EXPORT=/mnt/VDEV1/dce-backups

REVERSE_PROXY=traefik
TRAEFIK_NETWORK=traefik-net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_DYNAMIC_DIR=/opt/docker/Files/AppData/Config/traefik/dynamic

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
ACME_EMAIL=ari@rootpcs.com
